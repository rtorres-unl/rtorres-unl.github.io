{
    "name": "Jekyll",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": ["esbenp.prettier-vscode"]
        }
    },
    "postCreateCommand": "bundle install",
    "postAttachCommand": "bundle exec jekyll serve --livereload --host 0.0.0.0",
    "remoteUser": "vscode"
}
